{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "xn--oi2bj1bg5twzasy72kx8fj1ipxj.site"
        }
      ],
      "destination": "https://www.xn--oi2bj1bg5twzasy72kx8fj1ipxj.site/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/privacy(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "https://cdn.jsdelivr.net/gh/yisim817-byte/cheongna-arkone-prugio-main@main/assets/:path*"
    },
    {
      "source": "/contact",
      "destination": "/api/proxy?path=contact.html"
    },
    {
      "source": "/information",
      "destination": "/api/proxy?path=information.html"
    },
    {
      "source": "/location",
      "destination": "/api/proxy?path=location.html"
    },
    {
      "source": "/news",
      "destination": "/api/proxy?path=news.html"
    },
    {
      "source": "/overview",
      "destination": "/api/proxy?path=overview.html"
    },
    {
      "source": "/premium",
      "destination": "/api/proxy?path=premium.html"
    },
    {
      "source": "/privacy",
      "destination": "/api/proxy?path=privacy.html"
    },
    {
      "source": "/register",
      "destination": "/api/proxy?path=register.html"
    },
    {
      "source": "/units",
      "destination": "/api/proxy?path=units.html"
    },
    {
      "source": "/sitemap",
      "destination": "/api/proxy?path=sitemap.html"
    }
  ]
}
